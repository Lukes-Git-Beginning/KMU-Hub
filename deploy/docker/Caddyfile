app.zentria.tech {
	header {
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# LiveKit signaling (WebSocket) + token validation. Only /rtc* is exposed —
	# the twirp admin API stays internal. Media flows over WebRTC (7881/7882 +
	# TURN), so this proxy carries signaling only.
	# LIVEKIT_WS_URL in .env.production points here: wss://app.zentria.tech
	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy gateway:8080
	}
}

s3.zentria.tech {
	reverse_proxy minio:9000
}

# Marketing site (Astro/Node), moved off Vercel. It lives in the separate
# zentria-website repo and runs as its own compose project, attached to this
# project's default network — hence the service name works as an upstream here
# while deploy.sh never builds it.
#
# Staging host first: this block proves the container end to end before the
# apex A record moves. Replace with `zentria.tech` + a `www` redirect once the
# checks pass, and drop this one.
neu.zentria.tech {
	header {
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	reverse_proxy website:4321
}

# Fallback: IP-based access (HTTP only, remove once domain works)
:80 {
	reverse_proxy gateway:8080

	header {
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
