# ---------------------------------------------------------------------------
# LiveKit Secrets Overlay — Template
# ---------------------------------------------------------------------------
# Gerendert via deploy/scripts/render-configs.sh aus .env.production.
# Die gerenderte Datei (livekit-secrets.yaml) ist .gitignored und liegt
# nur auf Prod (oder lokal wenn manuell gerendert).
#
# WICHTIG — LiveKit (v1.7.2) merged mehrere `--config` NICHT key-by-key, sondern
# nimmt nur die LETZTE Datei (last-wins). In Prod ist das diese Datei, daher MUSS
# sie self-contained sein: keys, webhook UND der vollstaendige rtc-Block. Die
# Felder aus der Base-livekit.yaml (port, rtc, redis) werden in Prod NICHT
# angewandt. (Bestaetigt 2026-06-21: ein drittes rtc-only Overlay liess die keys
# verschwinden -> "keys must be provided"-Crash.)
#
# Aktivierung: docker-compose.prod.yml mountet diese Datei und ergaenzt
# `--config /etc/livekit-secrets.yaml` ans Command an.
# ---------------------------------------------------------------------------
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
webhook:
  api_key: ${LIVEKIT_API_KEY}
  urls:
    - http://gateway:8080/api/v1/webhooks/livekit
room:
  # empty_timeout: close an empty room after 15 min of inactivity so
  # room_finished fires and the meeting is auto-completed.
  empty_timeout: 900
  # departure_timeout: brief grace after the last participant leaves before
  # LiveKit declares the room empty and fires room_finished.
  departure_timeout: 60
# rtc: single UDP mux port 7882 (the only UDP port published by docker-compose),
# TCP fallback on 7881, and announce the server's public IP so the SFU is
# reachable by clients on other networks. (HTTP/WS stays on the default 7880.)
rtc:
  udp_port: 7882
  tcp_port: 7881
  use_external_ip: true
