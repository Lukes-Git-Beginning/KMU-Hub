# ===================================================================
# KMU Hub Production Environment
# CHANGE ALL "CHANGE_ME" VALUES BEFORE DEPLOYMENT
# ===================================================================

# ===== DATABASE =====
POSTGRES_USER=kmuhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=kmuhub
DATABASE_URL=postgres://kmuhub:CHANGE_ME_STRONG_PASSWORD@postgres:5432/kmuhub?sslmode=disable

# ===== CACHE =====
REDIS_URL=redis://redis:6379

# ===== AUTH =====
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
VAULT_MASTER_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING

# ===== GATEWAY =====
GATEWAY_HTTP_PORT=:8080
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN_OR_IP
RATE_LIMIT_RPS=50
BEHIND_PROXY=true

# ===== FILE STORAGE (MinIO) =====
MINIO_ROOT_USER=CHANGE_ME_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIMUM_16_CHARS
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIMUM_16_CHARS
MINIO_BUCKET=kmuhub-files
MINIO_USE_SSL=false
FILE_SIZE_LIMIT_MB=50

# ===== DOCUMENT EDITING (OnlyOffice/WOPI) =====
WOPI_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM
ONLYOFFICE_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM

# ===== VIDEO (LiveKit) =====
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_MINIMUM_32_CHARS
LIVEKIT_WS_URL=wss://YOUR_DOMAIN_OR_IP:7443
LIVEKIT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ===== TURN / coturn (Sprint 1 R2.1) =====
# Set after provisioning the CAX11 TURN server (deploy/turn/README.md).
# TURN_SECRET must match the --secret arg used with deploy/turn/deploy.sh
# and the static-auth-secret in /etc/turnserver.conf on the TURN server.
TURN_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
COTURN_HOST=turn.zentria.tech

# ===== MONITORING =====
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false

# ===== OPTIONAL INTEGRATIONS =====
