# ===================================================================
# KMU Hub Production Environment
# CHANGE ALL "CHANGE_ME" VALUES BEFORE DEPLOYMENT
# ===================================================================

# ===== ENVIRONMENT =====
# "production" arms the startup secrets assertion in every service: dev-default
# secrets and short/empty required values refuse to boot (config.Load -> exit 1).
# Deploy order matters — wire real secret values FIRST, then set this flag.
COSMI_ENV=production

# ===== DATABASE =====
# Sprint 4 Welle 2 (Migration 000121): two roles, two URLs.
# - kmuhub      : Postgres Superuser created by the official image — bypasses RLS.
#                 Used ONLY by the migrate container for DDL (CREATE EXTENSION,
#                 ALTER TABLE ENABLE ROW LEVEL SECURITY, CREATE POLICY).
# - kmuhub_app  : NOSUPERUSER NOBYPASSRLS role created by migration 000121.
#                 Used by all app services so RLS policies actually enforce.
# After migration 000121 runs the first time, set the kmuhub_app password via:
#   ALTER ROLE kmuhub_app WITH PASSWORD 'KMUHUB_APP_DB_PASSWORD value';
POSTGRES_USER=kmuhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=kmuhub
KMUHUB_APP_DB_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
DATABASE_URL=postgres://kmuhub_app:CHANGE_ME_STRONG_APP_PASSWORD@postgres:5432/kmuhub?sslmode=disable
MIGRATION_DATABASE_URL=postgres://kmuhub:CHANGE_ME_STRONG_PASSWORD@postgres:5432/kmuhub?sslmode=disable

# ===== CACHE =====
REDIS_URL=redis://redis:6379

# ===== AUTH =====
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
VAULT_MASTER_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING

# ===== TRANSACTIONAL SMTP (password-reset, booking confirmations) =====
# REQUIRED in production (config.RequireSystemSMTP): the auth service refuses to
# boot if HOST/USER/PASSWORD are empty, so a misconfigured relay can never silently
# drop password-reset or booking-confirmation mail. Use a transactional provider
# (Postmark/SES/Mailgun/…) — USER/PASSWORD are typically the API token. FROM must be
# a verified sender on a domain you control.
SYSTEM_SMTP_HOST=CHANGE_ME_smtp.provider.tld
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=CHANGE_ME
SYSTEM_SMTP_PASSWORD=CHANGE_ME
SYSTEM_SMTP_FROM=noreply@zentria.tech
# Frontend origin for password-reset links — must match the reset page route.
PASSWORD_RESET_BASE_URL=https://zentria.tech/reset-password

# ===== GATEWAY =====
GATEWAY_HTTP_PORT=:8080
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN_OR_IP
RATE_LIMIT_RPS=50
BEHIND_PROXY=true

# ===== FILE STORAGE (MinIO) =====
MINIO_ROOT_USER=CHANGE_ME_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIMUM_16_CHARS
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIMUM_16_CHARS
MINIO_BUCKET=kmuhub-files
MINIO_USE_SSL=false
FILE_SIZE_LIMIT_MB=50

# ===== DOCUMENT EDITING (OnlyOffice/WOPI) =====
WOPI_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM
ONLYOFFICE_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM

# ===== VIDEO (LiveKit) =====
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_MINIMUM_32_CHARS
# Public signaling URL clients connect to. Caddy proxies /rtc* on the app
# domain to livekit:7880, so this is the app domain itself — NOT :7443
# (that port was never mapped anywhere).
LIVEKIT_WS_URL=wss://YOUR_DOMAIN
LIVEKIT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ===== TURN / coturn (Sprint 1 R2.1) =====
# Set after provisioning the CAX11 TURN server (deploy/turn/README.md).
# TURN_SECRET must match the --secret arg used with deploy/turn/deploy.sh
# and the static-auth-secret in /etc/turnserver.conf on the TURN server.
TURN_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
COTURN_HOST=turn.zentria.tech

# ===== MONITORING =====
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false

# ===== ALERTING =====
# Alertmanager webhook for production alerts (ServiceDown, HighErrorRate, DBConnectionsHigh).
# Slack-format payload — Discord's slack-compatible endpoint works:
#   https://discord.com/api/webhooks/<id>/<token>/slack   (note the /slack suffix)
# If empty, Alertmanager runs without sending alerts (no crash, but no notifications).
ALERT_WEBHOOK_URL=

