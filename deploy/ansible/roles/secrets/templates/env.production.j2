# ===================================================================
# KMU Hub Production Environment
# Generated by Ansible secrets role — DO NOT EDIT MANUALLY
# Rendered: {{ ansible_date_time.iso8601 }}
# Host: {{ inventory_hostname }}
# ===================================================================

# ===== ENVIRONMENT =====
# Arms the startup secrets assertion in every service (dev-default or
# empty secrets refuse to boot). All values below are vault-provided,
# so the assertion passes by construction.
COSMI_ENV=production

# ===== DATABASE =====
POSTGRES_USER=kmuhub
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}
POSTGRES_DB=kmuhub
# App services use the non-superuser role (kmuhub_app) so RLS policies enforce.
# kmuhub_app has NOSUPERUSER NOBYPASSRLS — created in migration 000121.
KMUHUB_APP_DB_PASSWORD={{ KMUHUB_APP_DB_PASSWORD }}
DATABASE_URL={{ pilot_database_url }}
# migrate service uses the kmuhub superuser role for DDL (CREATE EXTENSION,
# ALTER TABLE ENABLE ROW LEVEL SECURITY, CREATE POLICY etc.).
MIGRATION_DATABASE_URL={{ pilot_migration_database_url }}

# ===== CACHE =====
REDIS_URL={{ pilot_redis_url }}

# ===== AUTH =====
JWT_SECRET={{ JWT_SECRET }}
ACCESS_TOKEN_EXPIRY={{ access_token_expiry }}
REFRESH_TOKEN_EXPIRY={{ refresh_token_expiry }}
VAULT_MASTER_SECRET={{ VAULT_MASTER_SECRET }}

# ===== GATEWAY =====
GATEWAY_HTTP_PORT=:{{ gateway_http_port }}
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins }}
RATE_LIMIT_RPS={{ rate_limit_rps }}
BEHIND_PROXY={{ behind_proxy }}

# ===== FILE STORAGE (MinIO) =====
MINIO_ROOT_USER=kmuhub-admin
MINIO_ROOT_PASSWORD={{ MINIO_ROOT_PASSWORD }}
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kmuhub-access
MINIO_SECRET_KEY={{ MINIO_SECRET_KEY }}
MINIO_BUCKET=kmuhub-files
MINIO_USE_SSL=false
# Public presign endpoint — Caddy proxies this domain to minio:9000 so
# presigned URLs are browser-reachable (see s3.zentria.tech in Caddyfile.j2).
{% if minio_public_domain is defined %}
MINIO_PUBLIC_ENDPOINT={{ minio_public_domain }}
MINIO_PUBLIC_USE_SSL=true
{% endif %}
FILE_SIZE_LIMIT_MB={{ file_size_limit_mb }}

# ===== DOCUMENT EDITING (OnlyOffice/WOPI) =====
WOPI_JWT_SECRET={{ WOPI_JWT_SECRET }}
ONLYOFFICE_JWT_SECRET={{ ONLYOFFICE_JWT_SECRET }}

# ===== VIDEO (LiveKit) =====
LIVEKIT_API_KEY={{ LIVEKIT_API_KEY }}
LIVEKIT_API_SECRET={{ LIVEKIT_API_SECRET }}
# Public signaling URL — Caddy proxies /rtc* on the pilot domain to livekit:7880.
LIVEKIT_WS_URL=wss://{{ pilot_domain }}
LIVEKIT_WEBHOOK_SECRET={{ LIVEKIT_WEBHOOK_SECRET }}

# ===== TURN / coturn (Sprint 1 R2.1) =====
# Set after provisioning the CAX11 TURN server (deploy/turn/README.md).
# TURN_SECRET must match the --secret arg used with deploy/turn/deploy.sh
# and the static-auth-secret in /etc/turnserver.conf on the TURN server.
TURN_SECRET={{ TURN_SECRET }}
COTURN_HOST=turn.zentria.tech

# ===== MONITORING =====
GF_SECURITY_ADMIN_PASSWORD={{ GF_SECURITY_ADMIN_PASSWORD }}
GF_USERS_ALLOW_SIGN_UP={{ gf_users_allow_sign_up }}

# ===== ALERTING =====
# Alertmanager webhook for production alerts (ServiceDown, HighErrorRate, DBConnectionsHigh).
# Slack-format payload — Discord's slack-compatible endpoint works:
#   https://discord.com/api/webhooks/<id>/<token>/slack   (note the /slack suffix)
# If empty, Alertmanager runs without sending alerts (no crash, but no notifications).
ALERT_WEBHOOK_URL=

# ===== OPTIONAL INTEGRATIONS =====
# Uncomment and fill in as needed:
# BEXIO_CLIENT_ID=
# BEXIO_CLIENT_SECRET=
# BEXIO_REDIRECT_URL=
# DATEV_CLIENT_ID=
# DATEV_CLIENT_SECRET=
# LEXWARE_API_BASE_URL=https://api.lexware.io
# SLACK_BOT_TOKEN=
# TEAMS_APP_ID=
