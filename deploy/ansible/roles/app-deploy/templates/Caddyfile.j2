{{ pilot_domain }} {
	header {
{% for header in caddy_security_headers %}
		{{ header }}
{% endfor %}
	}

	# LiveKit signaling (WebSocket) + token validation. Only /rtc* is exposed —
	# the twirp admin API stays internal. LIVEKIT_WS_URL points at the pilot
	# domain itself (wss://{{ pilot_domain }}).
	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy gateway:8080
	}
}

{% if minio_public_domain is defined %}
{{ minio_public_domain }} {
	reverse_proxy minio:9000
}

{% endif %}
# Fallback: IP-based access (HTTP only, remove once domain works)
:80 {
	reverse_proxy gateway:8080

	header {
		-Server ""
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
