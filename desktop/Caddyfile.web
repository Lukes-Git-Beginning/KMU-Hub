# Static serving for the Cosmi web app, inside the webapp container.
#
# Plain HTTP on :80 -- TLS, HSTS and the security headers are the job of the
# edge Caddy in deploy/docker/Caddyfile, which is the only thing exposed.

:80 {
	root * /srv/app
	encode gzip zstd

	# Fingerprinted bundles: cached hard, and explicitly NOT part of the SPA
	# fallback below. A missing asset has to answer 404, not index.html --
	# after a deploy an open tab still asks for the previous build's chunk
	# names, and handing it HTML with a 200 turns a clean "reload me" into
	# "Unexpected token '<'". (Caught on the :8081 staging port, where
	# /assets/nonexistent.js answered 200.)
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# index.html must never be cached: it points at the fingerprinted
		# bundles, so a cached copy would keep serving the previous deploy's
		# assets until the browser happened to revalidate.
		header Cache-Control "no-cache"

		# SPA fallback. The app uses a hash router, so deep links arrive as
		# "/#/kontakte" and never reach the server as a path -- but this keeps a
		# stray path from 404ing, and leaves the door open for history routing.
		try_files {path} /index.html
		file_server
	}
}
