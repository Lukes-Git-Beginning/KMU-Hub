{
    "hooks":  {
                  "SessionStart":  [
                                       {
                                           "hooks":  [
                                                         {
                                                             "type":  "command",
                                                             "command":  "bash .claude/hooks/session-start.sh",
                                                             "description":  "Compact git orientation at session start",
                                                             "timeout":  5000
                                                         },
                                                         {
                                                             "type":  "command",
                                                             "command":  "bash .claude/hooks/memory-size-guard.sh",
                                                             "description":  "Warn when MEMORY.md exceeds its 150-line/18KB budget",
                                                             "timeout":  3000
                                                         }
                                                     ]
                                       }
                                   ],
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "bash .claude/hooks/check-commit-message.sh",
                                                           "description":  "Enforce conventional commit messages (feat:|fix:|docs:|refactor:|test:|chore:)"
                                                       },
                                                       {
                                                           "type":  "command",
                                                           "command":  "bash .claude/hooks/check-no-secrets.sh",
                                                           "description":  "Block staging of files with secrets (.env, credentials, keys)"
                                                       }
                                                   ]
                                     }
                                 ]
              }
}