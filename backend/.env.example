# Application connection — uses the non-superuser kmuhub_app role so the
# RLS policies introduced by migration 000120 actually enforce. Superuser
# roles bypass RLS regardless of FORCE/BYPASSRLS settings. Migration 000121
# creates kmuhub_app; production needs a one-time
# `ALTER ROLE kmuhub_app WITH PASSWORD '...'` after the migration runs.
DATABASE_URL=postgres://kmuhub_app:app_dev@localhost:5432/kmuhub?sslmode=disable
# Migration runner connection — uses kmuhub-Superuser so DDL migrations
# (CREATE EXTENSION, ALTER TABLE, CREATE POLICY) keep working.
MIGRATION_DATABASE_URL=postgres://kmuhub:kmuhub_dev@localhost:5432/kmuhub?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-minimum-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
AUTH_GRPC_PORT=:50051
AUTH_GRPC_ADDRESS=localhost:50051
GATEWAY_HTTP_PORT=:8080
# Semicolon-delimited list of allowed CORS origins.
# Include http://localhost:5173 for Electron desktop dev mode.
CORS_ALLOWED_ORIGINS=http://localhost:3000;http://localhost:5173
RATE_LIMIT_RPS=100
BEHIND_PROXY=false

# ---------------------------------------------------------------------------
# LiveKit (video calls -- optional, feature-flagged)
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
LIVEKIT_WEBHOOK_SECRET=
LIVEKIT_EGRESS_TEMPLATE_URL=

# ---------------------------------------------------------------------------
# TURN / coturn (self-hosted NAT traversal -- optional)
# Provision via deploy/hetzner/coturn-setup.sh on a separate Hetzner CPX11.
# Leave empty to disable TURN; LiveKit works without it for same-network calls.
# ---------------------------------------------------------------------------
# Shared secret generated by coturn-setup.sh (openssl rand -hex 32).
# Must match static-auth-secret in /etc/turnserver.conf on the coturn server.
TURN_SECRET=
# FQDN of the coturn server. DNS A-record must point to the CPX11 public IP.
COTURN_HOST=turn.zentria.tech

# ---------------------------------------------------------------------------
# Feature flags — Sprint 2 modules (all OFF by default)
# ---------------------------------------------------------------------------
COSMI_MODULE_RAPPORTE_ENABLED=false
COSMI_MODULE_SCHICHTEN_ENABLED=false

VERMIETUNG_GRPC_PORT=:50077
VERMIETUNG_GRPC_ADDRESS=localhost:50077
VERMIETUNG_HEALTH_PORT=:9117
COSMI_MODULE_VERMIETUNG_ENABLED=false

# ---------------------------------------------------------------------------
# Idempotency mode — controls behaviour when Idempotency-Key header is absent.
# "hard" → 400 Bad Request (recommended for Dev; default in docker-compose.yml)
# unset  → WarnMode: logs a warning but allows request through (Production default)
# ---------------------------------------------------------------------------
# IDEMPOTENCY_MODE=hard  # Uncomment for local Dev (HardMode rejects requests without Idempotency-Key)
