FROM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o rapporte ./cmd/rapporte

FROM alpine:3.20

RUN apk --no-cache add ca-certificates wget

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app
COPY --from=builder /build/rapporte .

USER appuser

EXPOSE 50074 9114

CMD ["./rapporte"]
