FROM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG BUILD_VERSION=dev
ARG BUILD_COMMIT=unknown
ARG BUILD_TIME=unknown

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X github.com/kmuhub/kmuhub/internal/gateway.BuildVersion=$BUILD_VERSION -X github.com/kmuhub/kmuhub/internal/gateway.BuildCommit=$BUILD_COMMIT -X github.com/kmuhub/kmuhub/internal/gateway.BuildTime=$BUILD_TIME" \
    -o gateway ./cmd/gateway

FROM alpine:3.20

RUN apk --no-cache add ca-certificates wget

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app
COPY --from=builder /build/gateway .

USER appuser

EXPOSE 8080

CMD ["./gateway"]
